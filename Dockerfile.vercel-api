FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY pos/ ./pos/
COPY starter-kit/ ./starter-kit/
COPY scripts/container_start.py ./scripts/container_start.py
# Instance-local demo data cannot safely coordinate payments across Functions.
ENV PYTHONUNBUFFERED=1 ELUNO_API_ONLY=1 ELUNO_READ_ONLY=1
CMD ["python", "scripts/container_start.py"]
